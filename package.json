{
  "name": "crom-youtube-studio",
  "version": "1.0.0",
  "description": "Painel editorial multi-canal para YouTube com leitor/teleprompter Markdown, sincronizador RSS e ponte Kdenlive/MCP — zero dependências externas.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "crom-studio": "./bin/crom-studio"
  },
  "scripts": {
    "sync": "node src/sync.mjs",
    "sync:youtube": "node src/sync.mjs --youtube",
    "start": "node src/server.mjs",
    "roteiro": "node src/roteiro-git.mjs",
    "build:whiteboard": "node scripts/build-whiteboard.mjs",
    "postinstall": "node scripts/build-whiteboard.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "youtube",
    "markdown",
    "teleprompter",
    "kdenlive",
    "studio",
    "rss"
  ],
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
